@using Umbraco.Cms.Core.Strings
@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.ServicesPage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Core.Models.Blocks;
@{
	Layout = "MasterPage.cshtml";
	var pageHeading = Model.HasValue("pageHeading") ? Model.Value<string>("pageHeading") : Model.Name;
	var introduction = Model.Value<IHtmlEncodedString>("introduction");
	var servicesList = Model.Value<BlockListModel>("servicesList");
}

<!-- Page Header -->
<section class="page-header bg-primary text-white py-5">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<h1 class="display-4 fw-bold">@pageHeading</h1>
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item"><a href="@Model.Root().Url()" class="text-white">Home</a></li>
						<li class="breadcrumb-item active text-white" aria-current="page">@Model.Name</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</section>

<!-- Introduction Section -->
@if (introduction != null)
{
	<section class="py-5 bg-light">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-10">
					<div class="lead">
						@introduction
					</div>
				</div>
			</div>
		</div>
	</section>
}

<!-- Services List Section -->
@if (servicesList != null && servicesList.Any())
{
	<section class="py-5">
		<div class="container">
			<div class="row g-4">
				@foreach (var item in servicesList)
				{
					var content = (IPublishedElement)item.Content;
					var serviceTitle = content.Value<string>("serviceTitle");
					var serviceDescription = content.Value<string>("serviceDescription");
					var iconClass = content.Value<string>("serviceIconClass") ?? "bi-star";

					<div class="col-md-6 col-lg-4">
						<div class="card h-100 border-0 shadow-sm service-card">
							<div class="card-body p-4">
								<div class="service-icon text-primary mb-3" style="font-size: 3rem;">
									<i class="bi @iconClass"></i>
								</div>
								<h4 class="card-title fw-bold mb-3">@serviceTitle</h4>
								<p class="card-text text-muted">@serviceDescription</p>
								<a href="#" class="btn btn-outline-primary btn-sm mt-3">
									Learn More <i class="bi bi-arrow-right ms-1"></i>
								</a>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</section>
}
else
{
	<section class="py-5">
		<div class="container">
			<div class="alert alert-info">
				<i class="bi bi-info-circle me-2"></i>
				No services have been added yet. Please add services through the Umbraco backoffice.
			</div>
		</div>
	</section>
}