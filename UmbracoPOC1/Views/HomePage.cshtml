@using Umbraco.Cms.Core.Strings
@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.HomePage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "MasterPage.cshtml";
	var heroTitle = Model.HasValue("heroTitle") ? Model.Value<string>("heroTitle") : "Welcome to Our Government Portal";
	var heroSubtitle = Model.HasValue("heroSubtitle") ? Model.Value<string>("heroSubtitle") : "Serving our community with excellence";
	var heroImage = Model.Value<IPublishedContent>("heroImage");
	var welcomeText = Model.Value<IHtmlEncodedString>("welcomeText");
}

<!-- Hero Section -->
<section class="hero-section position-relative" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 400px;">
	<div class="container h-100 py-5">
		<div class="row align-items-center h-100">
			<div class="col-lg-8 text-white">
				<h1 class="display-4 fw-bold mb-4">@heroTitle</h1>
				<p class="lead mb-4">@heroSubtitle</p>
				<a href="services" class="btn btn-light btn-lg me-3">
					<i class="bi bi-arrow-right-circle me-2"></i>Our Services
				</a>
				<a href="contact" class="btn btn-outline-light btn-lg">
					<i class="bi bi-telephone me-2"></i>Contact Us
				</a>
			</div>
			@if (heroImage != null)
			{
				<div class="col-lg-4 d-none d-lg-block">
					<img src="@heroImage.Url()" alt="Hero Image" class="img-fluid rounded shadow-lg" />
				</div>
			}
		</div>
	</div>
</section>

<!-- Welcome Section -->
@if (welcomeText != null)
{
	<section class="py-5 bg-light">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-10">
					<div class="card border-0 shadow-sm">
						<div class="card-body p-5">
							@welcomeText
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}

<!-- Features/Benefits Section -->
<section class="py-5">
	<div class="container">
		<div class="row text-center mb-5">
			<div class="col-lg-12">
				<h2 class="display-5 fw-bold mb-3">Why Choose Us</h2>
				<p class="lead text-muted">We're committed to providing excellent public services</p>
			</div>
		</div>
		<div class="row g-4">
			<div class="col-md-4">
				<div class="card h-100 border-0 shadow-sm hover-card">
					<div class="card-body text-center p-4">
						<div class="feature-icon bg-primary bg-gradient text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
							<i class="bi bi-shield-check fs-2"></i>
						</div>
						<h4 class="fw-bold">Secure & Reliable</h4>
						<p class="text-muted">Your data is safe and protected with us</p>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="card h-100 border-0 shadow-sm hover-card">
					<div class="card-body text-center p-4">
						<div class="feature-icon bg-success bg-gradient text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
							<i class="bi bi-clock-history fs-2"></i>
						</div>
						<h4 class="fw-bold">24/7 Availability</h4>
						<p class="text-muted">Access services anytime, anywhere</p>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="card h-100 border-0 shadow-sm hover-card">
					<div class="card-body text-center p-4">
						<div class="feature-icon bg-info bg-gradient text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
							<i class="bi bi-people fs-2"></i>
						</div>
						<h4 class="fw-bold">Community Focused</h4>
						<p class="text-muted">We're here to serve you better</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>